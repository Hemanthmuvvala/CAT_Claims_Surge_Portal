# Copy to .env and fill in. Never commit .env.

PORT=3001
NODE_ENV=development

# PostgreSQL (pgAdmin: localhost:5432, database cat_claims)
DATABASE_URL=postgresql://postgres:Hemanth11%40@localhost:5432/cat_claims

# Python AI service (FastAPI). The default Node timeout exceeds the Python
# model-call timeout (60 seconds) to allow service and retrieval overhead.
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=70000

# JWT (reserved for a later milestone — auth stub is active for now)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Demo auth (prototype only — replaced by JWT later)
DEMO_DEFAULT_ROLE=manager
